// ID 1: Explorer uses the lowest-numbered icon group as the exe icon, and
// tray.rs loads the same ID for the notification area.
1 ICON "Inscriptio.ico"
// 24 = RT_MANIFEST, ID 1 = the process manifest (visual styles + DPI awareness).
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,4,2,0
PRODUCTVERSION 0,4,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "projectGloria"
            VALUE "FileDescription", "Inscriptio - Clipboard Link Trimmer"
            VALUE "FileVersion", "0.4.2"
            VALUE "InternalName", "inscriptio"
            VALUE "OriginalFilename", "inscriptio.exe"
            VALUE "ProductName", "Inscriptio"
            VALUE "ProductVersion", "0.4.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
